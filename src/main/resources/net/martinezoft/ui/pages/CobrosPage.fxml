<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox" styleClass="pagina-cobros" spacing="16.0" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label styleClass="titulo-pagina" text="Cobros pendientes" />
      <Label fx:id="total" styleClass="form-field-etiqueta" />
      <HBox spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="texto-secundario" text="Deudores" />
                  <StackPane fx:id="slotDeudores" VBox.vgrow="ALWAYS" />
                  <Label styleClass="texto-secundario" text="Visitas sin pagar" />
                  <StackPane fx:id="slotVisitas" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <StackPane fx:id="slotFormulario" minWidth="320.0" prefWidth="320.0" />
         </children>
      </HBox>
   </children>
</fx:root>
