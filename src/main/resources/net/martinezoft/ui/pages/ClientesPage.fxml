<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox" styleClass="pagina-clientes" spacing="16.0" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label styleClass="titulo-pagina" text="Clientes" />
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <Tab text="Clientes">
               <content>
                  <HBox spacing="16.0">
                     <children>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                           <children>
                              <TextField fx:id="buscador" promptText="Buscar por nombre o teléfono" />
                              <StackPane fx:id="slotClientes" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                        <StackPane fx:id="slotClienteForm" minWidth="320.0" prefWidth="320.0" />
                     </children>
                  </HBox>
               </content>
            </Tab>
            <Tab fx:id="tabMascotas" text="Mascotas">
               <content>
                  <HBox spacing="16.0">
                     <children>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="tituloMascotas" styleClass="texto-secundario" />
                              <StackPane fx:id="slotMascotas" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                        <StackPane fx:id="slotMascotaForm" minWidth="320.0" prefWidth="320.0" />
                     </children>
                  </HBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</fx:root>
