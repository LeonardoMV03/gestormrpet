<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox" styleClass="panel-formulario" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label fx:id="titulo" styleClass="form-field-etiqueta" />
      <Label fx:id="detalle" styleClass="texto-secundario" wrapText="true" />
      <Label fx:id="total" styleClass="form-field-etiqueta" />
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <ComboBox fx:id="metodo" prefWidth="150.0" />
            <Button fx:id="botonCobrar" styleClass="boton-primario" text="Registrar pago" />
         </children>
      </HBox>
      <Label fx:id="etiquetaMensaje" styleClass="etiqueta-mensaje" wrapText="true" />
      <Label fx:id="etiquetaError" styleClass="form-field-error" wrapText="true" />
   </children>
</fx:root>
