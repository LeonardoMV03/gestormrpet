{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "planificador",
  "permission": {
    "bash": {
      "*": "ask",
      "mvn *": "allow",
      "java *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git switch*": "allow",
      "git checkout*": "allow",
      "git branch*": "allow",
      "git push origin feature/*": "allow",
      "git push -u origin feature/*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh issue create*": "allow",
      "gh issue comment*": "allow",
      "gh issue edit*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr create*": "allow",
      "gh pr comment*": "allow",
      "gh pr checks*": "allow",
      "gh pr review*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh project view*": "allow",
      "gh project item-list*": "allow",
      "gh pr merge*": "deny",
      "git push origin main*": "deny",
      "git push origin develop*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny"
    }
  }
}
